{
  // Repo-wide markdownlint config. Prose docs wrap freely, so line-length is off.
  "config": {
    "default": true,
    "MD013": false, // line-length — prose and tables run long on purpose
    "MD033": false, // inline HTML — used for collapsible <details> blocks
    "MD041": false  // first line need not be a top-level heading (frontmatter)
  },
  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/.git/**",
    "**/.superpowers/**"
  ]
}
